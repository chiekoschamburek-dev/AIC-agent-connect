# DeepSeek/OpenAI 兼容接口。不要把真实密钥提交到代码仓库或聊天中。
export OPENAI_MODEL="deepseek-chat"
export OPENAI_API_KEY="在服务器上填写"
export OPENAI_BASE_URL="https://你的模型服务地址/v1"

# 梧桐注册信息。正式 endpoint 不要在末尾添加 /rpc，WIT 会自动生成 RPC 路径。
export ACPS_PUBLIC_ENDPOINT="https://8.160.176.215:8590"
export ACPS_ORGANIZATION="填写小组或组织名称"
export ACPS_COUNTRY_CODE="CN"

# 梧桐登录凭据。仅在执行 enroll 时需要，禁止对外发送。
export ACPS_USERNAME="在服务器上填写"
export ACPS_PASSWORD="在服务器上填写"

export ACPS_BIND_HOST="0.0.0.0"
export ACPS_BIND_PORT="8590"
export WIT_WORKSPACE=".wit/scinexus-research-designer"
