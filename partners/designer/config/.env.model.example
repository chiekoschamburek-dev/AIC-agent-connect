# 复制为 .env.model 后填写真实值；不要提交真实配置。

export OPENAI_BASE_URL="https://api.deepseek.com"
export OPENAI_MODEL="deepseek-chat"
export OPENAI_API_KEY="<填写模型 API Key>"
unset OPENAI_PROXY_URL

