# ============================================================================
# 问迹 · ACPs / AIP 接入配置模板
# 复制到仓库根目录 .env 或 .env.acps（两者都会被 CLI 加载，且已被 .gitignore 排除）
# 安全红线：ACPS_USERNAME / ACPS_PASSWORD / 私钥材料永不入库、永不写进提交材料
# ============================================================================

# 开关：1 时后端可加载 ACPs 适配层；完成注册并确认对外地址后再置 1
ACPS_ENABLED=0

# 接入形态：wt = 梧桐智能体互联平台（参赛验证场景）；ioa_pub = WIT 内置 ioa.pub；custom = 自建
ACPS_PROFILE=wt

# ---- 智能体身份（会进入 ACS，注册平台审核时可见）----
ACPS_AGENT_ID=wenji-aip-agent
ACPS_DISPLAY_NAME=问迹·可解释问数问答智能体
ACPS_AGENT_VERSION=1.0.0
ACPS_ORGANIZATION=<注册平台里填写的组织名>
ACPS_COUNTRY_CODE=CN

# ---- 运行与对外地址 ----
# workspace 存放注册状态、证书与私钥（.gitignore 已排除）
ACPS_WORKSPACE=.wit/wenji-aip-agent
ACPS_LISTEN_HOST=0.0.0.0
ACPS_LISTEN_PORT=8443
# 【注册前必改】必须是从平台/其它智能体可解析可访问的 HTTPS 基地址；
# 必须是 DNS 名或 IP，且证书 SAN 会覆盖它（不能写 0.0.0.0）。
# 注意：不带任何路径后缀！WIT 监听器路由在根路径，ACS 端点会自动补 /rpc
ACPS_PUBLIC_ENDPOINT=https://<your-domain-or-ip>:<port>
ACPS_STRICT_INTEROP=1
ACPS_REQUEST_TIMEOUT_SECONDS=60

# ---- 梧桐平台基础设施（默认值即实测正确的 wt.ioa.pub）----
# 规则：registry/ca 只写到服务根（WIT 自动拼 /acps-atr-v2 等，拼重了会 404）；
# discovery 是完整端点（含 /acps-adp-v2/discover）；
# registry-mtls 留空：integrated 注册用不到，仅 ontology 派生实体时才需要
ACPS_REGISTRY_URL=https://wt.ioa.pub/registry-server
ACPS_CA_URL=https://wt.ioa.pub/ca-server
ACPS_DISCOVERY_URL=https://wt.ioa.pub/discovery/acps-adp-v2/discover

# ---- 注册平台账号（仅本地填写，切勿提交；用于 WIT 自动注册/登录）----
ACPS_USERNAME=
ACPS_PASSWORD=

# ---- Leader 侧：发现并委派给平台上队友的智能体 ----
ACPS_DELEGATE_ENABLED=1
ACPS_DELEGATE_DELIVERY=rpc

# ---- WIT 包装层的模型（默认复用仓库既有 DeepSeek 配置；可单独指向低成本模型）----
# ACPS_LLM_BASE_URL=https://api.deepseek.com/v1
# ACPS_LLM_MODEL=deepseek-chat
# ACPS_LLM_API_KEY=

# ---- AMP 周期日志类别（heartbeat/metrics/system；access 由 Direct transport 产生）----
# ACPS_AMP_PERIODIC_LOGS=heartbeat,metrics,system
