[Unit]
Description=WenJi AMP journal forwarder (-> wt.ioa.pub:19092)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hkr/projects/aic/wenji-aip-agent/backend
ExecStart=/home/hkr/projects/aic/wenji-aip-agent/backend/.venv/bin/python /home/hkr/projects/aic/wenji-aip-agent/tools/amp_forwarder/forwarder.py --journal-dir /home/hkr/projects/aic/wenji-aip-agent/backend/.wit/wenji-aip-agent
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
