[Unit]
Description=WenJi LLM proxy -> BUPT campus gateway (127.0.0.1:18999)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hkr/projects/aic/wenji-aip-agent/backend
ExecStart=/home/hkr/projects/aic/wenji-aip-agent/backend/.venv/bin/python -m uvicorn app.acps.llm_proxy:app --host 127.0.0.1 --port 18999
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
