# 模板：由 deploy.sh install-units 渲染 __ACPS_ROOT__ / __ACPS_PY__ 后安装；
# 不要直接把本文件拷进 /etc/systemd/system。
[Unit]
Description=Wit ACPs Yanshu AMP Access Sender (local amp_access_*.jsonl -> Kafka amp.access)
Documentation=file://__ACPS_ROOT__/docs/incident-2026-10-19-ranking-zero.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wit
Group=wit
WorkingDirectory=__ACPS_ROOT__/acps_cluster

# 只转 access，topic 固定 amp.access；与心跳转发器 wit-amp-sender 完全独立。
# 心跳是生产命脉（停了 1–2 分钟全集群被判离线），绝不能为了 access 去改它。
# --send 才真投；不带 --send 是 dry-run，本单元显式带 --send。
ExecStart=__ACPS_PY__ __ACPS_ROOT__/acps_cluster/deploy/amp_access_sender.py \
    --source-dir __ACPS_ROOT__/acps_cluster \
    --topic amp.access \
    --send --watch --interval 15

Restart=always
RestartSec=30
TimeoutStopSec=20

# 只允许写自己的位点目录（同 wit-yanshu@.service 的最小权限思路）
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=__ACPS_ROOT__/acps_cluster

[Install]
WantedBy=multi-user.target
