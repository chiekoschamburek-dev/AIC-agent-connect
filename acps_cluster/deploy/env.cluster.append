# ============================================================
# 研枢集群（第二批）：Scout / Synthesis / Writer / Critic 四伙伴 + Supervisor
# 每个 agent 需一个独立的官方账号（各自独立人工审核）；账号在 https://www.ioa.pub/registry 注册
# 账号密码注册后填到下面（把引号连占位符一起替换成真实值）
# ============================================================
ACPS_SCOUT_PORT=8445
ACPS_SYNTHESIS_PORT=8446
ACPS_WRITER_PORT=8447
ACPS_CRITIC_PORT=8448
ACPS_SUPERVISOR_PORT=8444

ACPS_SCOUT_USERNAME='<官方账号-scout>'
ACPS_SCOUT_PASSWORD='<强随机密码>'
ACPS_SYNTHESIS_USERNAME='<官方账号-synthesis>'
ACPS_SYNTHESIS_PASSWORD='<强随机密码>'
ACPS_WRITER_USERNAME='<官方账号-writer>'
ACPS_WRITER_PASSWORD='<强随机密码>'
ACPS_CRITIC_USERNAME='<官方账号-critic>'
ACPS_CRITIC_PASSWORD='<强随机密码>'
ACPS_SUPERVISOR_USERNAME='<官方账号-supervisor>'
ACPS_SUPERVISOR_PASSWORD='<强随机密码>'

# ---- 第三批：Contradiction（矛盾侦测）+ Frontier（速度前沿）----
ACPS_CONTRADICTION_PORT=8449
ACPS_FRONTIER_PORT=8450

ACPS_CONTRADICTION_USERNAME='<官方账号-contradiction>'
ACPS_CONTRADICTION_PASSWORD='<强随机密码>'
ACPS_FRONTIER_USERNAME='<官方账号-frontier>'
ACPS_FRONTIER_PASSWORD='<强随机密码>'

# ---- 2026-10-25 workspace / 存储资源（平台注册态）----
# provider.name 必须与平台已批 ACS 一致；不设会回退成 yanshu-lab
ACPS_PROVIDER_NAME=wit-research-lab
# 工作区管理员与现有平台账号同号；单独账号时替换：
# ACPS_WORKSPACE_PORT=8470
# ACPS_WORKSPACE_USERNAME='<官方账号-workspace>'
# ACPS_WORKSPACE_PASSWORD='<强随机密码>'

# ---- 2026-10-06 审查 #5:资源伙伴默认启用 PEP(生产姿态) ----
ACPS_PEP_ENABLED=1
# 签发者白名单按节点填平台/本地 supervisor 的 AIC:
# ACPS_PEP_LEADER_AICS=1.2.156.3088.1.BUPT.VTF97R.JXN8O8.98DOO8.0EB6

# ---- 工作流可视化链接（可选；不设则关闭）----
# leader 结果里追加“打开工作流”的 Markdown 链接；页面为 cluster-viz 的本次任务回放。
# ACPS_VIZ_BASE_URL=https://viz.example.com
# ACPS_VIZ_SCENARIO_DIR=/srv/cluster-viz/scenarios
