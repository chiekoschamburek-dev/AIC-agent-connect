# 模板：由 deploy.sh install-units 渲染 __ACPS_ROOT__ / __ACPS_PY__ 后安装；
# 不要直接把本文件拷进 /etc/systemd/system。
[Unit]
Description=AMP Heartbeat Sender (mirror → platform Kafka amp.heartbeat) [option B]
Documentation=file:__ACPS_ROOT__/acps_cluster/deploy/AMP_FORWARDER.md
After=network-online.target wit-amp-mirror.service
Wants=network-online.target
Requires=wit-amp-mirror.service

[Service]
Type=simple
User=wit
Group=wit
WorkingDirectory=__ACPS_ROOT__/acps_cluster
# B 方案：按官方 Forwarder 同语义把我们镜像目录里的新增心跳投到平台 amp.heartbeat
ExecStart=__ACPS_PY__ deploy/amp_heartbeat_sender.py \
    --mirror-dir /var/log/acps-amp \
    --broker 192.0.2.20:19092 \
    --topic amp.heartbeat \
    --watch --interval 15 \
    --send

Restart=always
RestartSec=20
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/log/acps-amp

[Install]
WantedBy=multi-user.target
