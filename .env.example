# OpenAI 配置（必填）
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 地址（可选，默认 https://api.openai.com/v1）
# 使用兼容接口时取消注释并填写，如：
# OPENAI_BASE_URL=https://your-compatible-api.com/v1

# 单次模型请求超时秒数（可选，默认 300；论文写作阶段建议 >=300）
# OPENAI_TIMEOUT=300

# ── 工作流可视化链接（可选；不设则完全关闭，产物里不会多出链接）──
# leader 每次任务结束后，把本次 Scenario 写到该目录，并在 aip_submit 产物里
# 追加一条“打开工作流”的 Markdown 链接（叮当结果消息里可点击）。
# ACPS_VIZ_BASE_URL=https://viz.example.com
# 默认目录是仓库内 cluster-viz/public/scenarios；服务器上请指向静态站点实际
# 托管的 scenarios 目录（或做同步）。
# ACPS_VIZ_SCENARIO_DIR=/srv/cluster-viz/scenarios

# ── 第三方算力（GPU/CPU 属于算力公司时）──
# 算力方签发 grant 后通过带外通道投递；experiment 只加载，不以研枢 leader 签名。
# ACPS_COMPUTE_GRANT_FILE=/opt/wit/yanshu-AIC/acps_cluster/ws-experiment/acps/grants/compute-gpu.grant.json

# ── PEP 准入（安全相关；资源类 partner 必须开）──
# 总开关
# ACPS_PEP_ENABLED=1
# 承认其签发资格、且默认允许直调（免令牌）的 leader AIC，逗号分隔
# ACPS_PEP_LEADER_AICS=
# 资源类 agent 关闭"白名单 leader 直调免令牌"，只保留签发资格
# ACPS_PEP_LEADER_DIRECT=0
# 未指名 skill 时是否允许无凭据入场。其他 agent 默认 1（入场放宽、能力面收紧）；
# supervisor 由代码强制置 0——否则任何入站任务都会触发完整编排并让 leader 代签算力令牌。
# ACPS_PEP_ALLOW_UNSCOPED_ENTRY=1
# 允许"未指名 skill 即触发整链执行"的调用方 AIC（与签发资格分开，避免误授权）
# ACPS_PEP_INBOUND_ALLOW_AICS=
# supervisor 专用别名，与上一条取并集
# 生产（2026-10-25）：叮当发任务不指名 skill，不列入则被 H1 收口拒绝
# （deny/no-credential，平台侧显示 Authentication required）。叮当身份末两段会轮换
# （历史：…EZTK03.JISTB6.0P3V / …EZTK03.KXO4IK.13NO），再遇拒绝照此续补。
# ACPS_SUPERVISOR_INBOUND_ALLOW_AICS=1.2.156.3088.1.0001.00001.EZTK03.JISTB6.0P3V,1.2.156.3088.1.0001.00001.EZTK03.KXO4IK.13NO

# ── gpu.data.fetch 的 SSRF 防线 ──
# 默认拒绝内网 / 回环 / 链路本地 / 保留地址。本地演示需要回环数据源时显式打开：
# ACPS_GPU_DATA_ALLOW_LOOPBACK=1
# 内网镜像（如公司内网对象存储）需显式打开；优先用 ACPS_GPU_DATA_DOMAINS 点名具体主机：
# ACPS_GPU_DATA_ALLOW_PRIVATE=1
# 显式主机白名单（命中即跳过内网检查），逗号分隔
# ACPS_GPU_DATA_DOMAINS=mirrors.example.com

# ── provider 身份（必须与平台已批 ACS 一致）──
# 平台记录 provider.name=wit-research-lab；不设会回退成 yanshu-lab，
# 导致 ACS 投影指纹与注册版不同。
# ACPS_PROVIDER_NAME=wit-research-lab

# ── 工作区管理员 / 存储资源（平台注册态，端口 8470）──
# ACPS_WORKSPACE_PORT=8470
# ACPS_WORKSPACE_USERNAME=<平台账号>
# ACPS_WORKSPACE_PASSWORD=<平台口令>
# 注册模式禁止裸奔：ws.* 全部非公开，准入与 task_id 作用域都依赖 PEP
# ACPS_PEP_ENABLED=1
# ACPS_PEP_LEADER_AICS=<supervisor 的 AIC>
# 工作区根目录、单任务配额、克隆超时、单次读取上限
# ACPS_WS_ROOT=/opt/wit/yanshu-AIC/acps_cluster/ws-workspace/workspaces
# ACPS_WS_TASK_QUOTA_MB=512
# ACPS_WS_CLONE_TIMEOUT=120
# ACPS_WS_MAX_READ_BYTES=1048576
# 克隆目标默认拒绝回环/内网；内网镜像用域名点名，或显式打开
# ACPS_WS_CLONE_DOMAINS=git.example.com
# ACPS_WS_CLONE_ALLOW_PRIVATE=1
# ACPS_WS_CLONE_ALLOW_LOOPBACK=1
# 仅测试用：允许 file:// 本地仓库
# ACPS_WS_CLONE_ALLOW_FILE=1

# ── 研究伙伴读写任务工作区（2026-10-26；supervisor 与 partner 两侧同一口径）──
# 逗号分隔的名册 key。默认七个研究伙伴全开；留空即关闭（= 只有 supervisor 能用工作区）。
# supervisor 据此随委派签发 ws.list/ws.read/ws.write 三枚令牌；partner 据此装配
# ws_list/ws_read/ws_write 工具。两侧不一致只会"有令牌没工具"（返回 awaiting），不越权。
# ACPS_WS_PARTNER_ACCESS=scout,experiment,synthesis,writer,critic,contradiction,frontier
# partner 令牌有效期（秒，上限 600）
# ACPS_WS_PARTNER_TOKEN_TTL=600
# partner 侧 ws 调用：等待上限 / 单次读上限 / 单次写上限 / 带 bundle 任务的步数下限
# ACPS_WS_CLIENT_TIMEOUT=180
# ACPS_WS_CLIENT_MAX_READ_BYTES=262144
# ACPS_WS_CLIENT_MAX_WRITE_BYTES=262144
# ACPS_WS_PARTNER_MIN_STEPS=16
# 注：旧的 ACPS_WS_MIRROR（supervisor 收尾本地直写 products/）已删除——
# 产物一律经持令牌的 ws.write 写入，workspace DB 与 manifest 才看得到。

# ── guard 三层：PEP（事前准入）/ RunGuard（事中止损）/ guard-api+adapter（事中事后取证）──
# guard-api（可选 HTTP 接口层；FastAPI 依赖见 guard-api/requirements.txt）
# 设了端口才挂载；token 配置后所有端点要求 Bearer
# ACPS_GUARD_API_PORT=8778
# ACPS_GUARD_DB=acps_cluster/ws-supervisor/acps/aip-tasks.sqlite3
# ACPS_GUARD_TOKEN=
# 运行中守卫：observe（默认，只落审计）/ enforce（中止并 aip_fail 上报）/ off
# ACPS_RUN_GUARD=observe
# ACPS_GUARD_WALL_SECONDS=13800
# ACPS_GUARD_IDLE_SECONDS=1500
# ACPS_GUARD_PROGRESS_SECONDS=5400
# ACPS_GUARD_ERROR_LIMIT=8
# ACPS_GUARD_REPEAT_LIMIT=16
# ACPS_GUARD_STEP_LIMIT=195
# ACPS_GUARD_WAIT_LIMIT=30

